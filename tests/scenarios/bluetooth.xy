# Bluetooth (app/bt.c): Setup's one row, BT MIDI with a computer (this build has no Bluetooth audio and no Bluetooth
# MIDI devices: LOOM_BT_AUDIO 0, ble_central = false). GLO's SEL list on Setup has BT MIDI (on or off) and nothing
# for devices; BT MIDI off (no advertising) kept over a restart; a computer's link shown on the row; a pairing's code
# in the header
wait 1500
tap GLO
turn SELECT -2
wait 100
expect page Setup
shot bt_setup.png
listen
# SEL on Setup: Setup's own list, on BT MIDI; no AUDIO DEVICE, BT AUDIO or MIDI DEVICE rows
tap SEL
wait 300
said BT MIDI on
shot bt_glo_list.png
tap HOME
wait 100
# BT MIDI off: no advertising
tap SEL
turn ALGO -1
wait 200
said BT MIDI off
expect ble 0
tap HOME
wait 100
shot bt_setup_midi_off.png
# saved, then a restart: BT MIDI stays off
tap SAVE
wait 100
reboot
wait 2000
expect ble 0
tap GLO
turn SELECT -2
wait 100
shot bt_after_reboot.png
listen
where
said BT MIDI off
# BT MIDI on again (SEL toggles it too)
tap SEL
tap SEL
wait 1200
said BT MIDI on
expect ble 2
# a computer connected: the row says so
ble connect
wait 200
tap HOME
tap GLO
turn SELECT -2
wait 100
where
said BT MIDI computer connected
shot bt_setup_computer.png
ble disconnect
# a pairing's code: the header shows it on every page, the reader says it digit by digit
tap SEQ
passkey 42613
wait 100
said PIN 0 4 2 6 1 3
shot bt_pin.png
passkey -1
wait 100
